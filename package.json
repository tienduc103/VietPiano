{
  "name": "vietpiano",
  "version": "1.0.0",
  "description": "VietPiano — PWA học piano trên iPad, nhận diện nốt qua microphone",
  "scripts": {
    "dev": "vite",
    "dev:https": "cross-env HTTPS=1 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
